{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["servers", "nodeExporter", "customExporter", "slack"],
  "properties": {
    "servers": {
      "type": "array",
      "items": {
        "type": "object", "required": ["address"],
        "properties": {
          "address": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "nodeExporterPort": {"type": "integer", "minimum": 1, "maximum": 65535},
          "customExporterPort": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "nodeExporter": {
      "type": "object", "required": ["port"],
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "customExporter": {
      "type": "object", "required": ["enabled", "port"],
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535}
      }
    },
    "slack": {
      "type": "object", "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  }
}
