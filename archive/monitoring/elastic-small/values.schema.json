{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["existingSecret", "elasticsearch", "kibana"],
  "properties": {
    "existingSecret": {"type": "string", "minLength": 1},
    "elasticsearch": {
      "type": "object",
      "required": ["image", "persistence", "heap", "resources"],
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "persistence": {
          "type": "object", "required": ["size", "storageClass"],
          "properties": {
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Gi|G|Mi|M)$"},
            "storageClass": {"type": "string"}
          }
        },
        "heap": {"type": "string", "pattern": "^[1-9][0-9]*[mg]$"}
      }
    },
    "kibana": {
      "type": "object", "required": ["enabled", "image", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"}
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object", "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}
      }
    }
  }
}
