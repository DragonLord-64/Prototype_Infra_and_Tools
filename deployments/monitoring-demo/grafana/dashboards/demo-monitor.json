{
  "id": null,
  "uid": "demo-monitor",
  "title": "Demo Monitor",
  "tags": ["demo-monitor"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Server (node_exporter)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "up{job=\"server-node-exporter\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Server load average (1m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "node_load1{job=\"server-node-exporter\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Server memory available",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes{job=\"server-node-exporter\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Switch (custom exporter)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Interface link status",
      "description": "1 = link up, 0 = link down (injectable failure). Metric name/labels per switch-container's proposal in DotWorld comms — update if it lands differently.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "switch_interface_link_up{job=\"switch-exporter\"}",
          "legendFormat": "{{interface}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Interface RX bytes/sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(switch_interface_rx_bytes_total{job=\"switch-exporter\"}[1m])",
          "legendFormat": "{{interface}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Interface TX bytes/sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(switch_interface_tx_bytes_total{job=\"switch-exporter\"}[1m])",
          "legendFormat": "{{interface}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Switch VLANs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "table",
      "title": "VLANs per switch",
      "description": "Count of distinct VLANs configured on each switch (switch_vlan_packets_total is one series per VLAN, agnostic of any interface).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "count by (switch) (switch_vlan_packets_total{job=\"switch-exporter\"})",
          "legendFormat": "{{switch}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 22,
      "type": "table",
      "title": "VLANs trunked per interface",
      "description": "Each interface carries a random 6-60 of the switch's VLANs (switch_interface_vlan_member).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "count by (switch, interface) (switch_interface_vlan_member{job=\"switch-exporter\"})",
          "legendFormat": "{{switch}} {{interface}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Top VLAN traffic (packets/sec)",
      "description": "Busiest VLANs by switch-wide counter rate -- too many VLANs to plot all of them, so this shows the top 10.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "topk(10, rate(switch_vlan_packets_total{job=\"switch-exporter\"}[1m]))",
          "legendFormat": "{{switch}} vlan {{vlan}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "type": "table",
      "title": "Interfaces carrying VLAN $vlan",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "switch_interface_vlan_member{job=\"switch-exporter\", vlan=\"$vlan\"}",
          "legendFormat": "{{switch}} {{interface}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "vlan",
        "label": "VLAN",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(switch_vlan_packets_total{job=\"switch-exporter\"}, vlan)", "refId": "VLANVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  }
}
