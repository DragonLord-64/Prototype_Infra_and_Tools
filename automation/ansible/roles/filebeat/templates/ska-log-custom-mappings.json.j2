{
  "_meta": {
    "description": "SKA custom log fields (ska_*, ska.audit.*, ska.audit.octopus.*)",
    "managed_by": "ansible"
  },
  "template": {
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "ska_function": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "ska_pipeline": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "ska_line_loc": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "ska_message": {
          "type": "text"
        },
        "ska_log_timestamp": {
          "type": "date"
        },
        "ska_severity": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "ska_tags": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "ska_thread_id": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "ska_version": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "ska_transaction_id": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "ska": {
          "properties": {
            "audit": {
              "properties": {
                "timestamp": {
                  "type": "date"
                },
                "hostname": {
                  "type": "text",
                  "fields": {
                    "keyword": {
                      "type": "keyword",
                      "ignore_above": 256
                    }
                  }
                },
                "loglevel": {
                  "type": "text",
                  "fields": {
                    "keyword": {
                      "type": "keyword",
                      "ignore_above": 256
                    }
                  }
                },
                "node": {
                  "type": "text",
                  "fields": {
                    "keyword": {
                      "type": "keyword",
                      "ignore_above": 256
                    }
                  }
                },
                "username": {
                  "type": "text",
                  "fields": {
                    "keyword": {
                      "type": "keyword",
                      "ignore_above": 256
                    }
                  }
                },
                "user": {
                  "type": "text",
                  "fields": {
                    "keyword": {
                      "type": "keyword",
                      "ignore_above": 256
                    }
                  }
                },
                "workdir": {
                  "type": "text",
                  "fields": {
                    "keyword": {
                      "type": "keyword",
                      "ignore_above": 256
                    }
                  }
                },
                "message": {
                  "type": "text"
                },
                "octopus": {
                  "properties": {
                    "ts": {
                      "type": "date"
                    },
                    "action": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "outcome": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "summary": {
                      "type": "text",
                      "fields": {
                        "raw": {
                          "type": "keyword",
                          "ignore_above": 512
                        }
                      }
                    },
                    "actor": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "actor_role": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "actor_role_level": {
                      "type": "integer"
                    },
                    "on_behalf_of": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "target": {
                      "type": "keyword",
                      "ignore_above": 512
                    },
                    "transport": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "client_id": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "source_ip": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "detail": {
                      "type": "text"
                    },
                    "field": {
                      "type": "keyword"
                    },
                    "duration_ms": {
                      "type": "float"
                    },
                    "workspace": {
                      "type": "keyword",
                      "ignore_above": 512
                    },
                    "widget": {
                      "type": "keyword",
                      "ignore_above": 512
                    },
                    "widget_source": {
                      "type": "keyword",
                      "ignore_above": 1024
                    },
                    "device": {
                      "type": "keyword",
                      "ignore_above": 512
                    },
                    "command": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "changed": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "settings": {
                      "type": "keyword",
                      "ignore_above": 512
                    },
                    "previous_name": {
                      "type": "keyword",
                      "ignore_above": 512
                    },
                    "grants": {
                      "type": "integer"
                    },
                    "operations": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "provider": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "activated": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "text"
                    },
                    "diff_lines": {
                      "type": "integer"
                    },
                    "args": {
                      "type": "object",
                      "enabled": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

