Port 2222
ListenAddress 0.0.0.0
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Public keys only. The uploader account has no password at all.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
UsePAM no

# Regenerated by the sync job from the config repo's public-keys manifest --
# see mirror_sync.mirror.regenerate_authorized_keys(). Looked up before the
# chroot below is applied, so it lives outside /var/mirror/files.
AuthorizedKeysFile /etc/ssh/authorized_keys/%u

Subsystem sftp internal-sftp

# SFTP-only, chrooted straight to the nginx-served root -- no separate
# "incoming" folder, no shell, no port forwarding. Trade-off accepted per
# the design: anyone with upload access can write anywhere in the tree.
Match User uploader
    ChrootDirectory /var/mirror/files
    ForceCommand internal-sftp
    AllowTcpForwarding no
    X11Forwarding no
    PermitTunnel no
