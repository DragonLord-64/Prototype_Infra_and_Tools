.env*

# air-gapped-mirror
deployments/air-gapped-mirror/sync-job/.venv/
deployments/air-gapped-mirror/sync-job/**/__pycache__/
deployments/air-gapped-mirror/sync-job/.pytest_cache/
deployments/air-gapped-mirror/test/keys/

# monitoring
deployments/monitoring/k8s/grafana-admin-secret.yaml
automation/ansible/.venv/

# netbox-import
tools/netbox/csv-import/.venv/
tools/netbox/csv-import/**/__pycache__/
tools/netbox/csv-import/.pytest_cache/
tools/netbox/inventory-collector/output/
tools/netbox/inventory-collector/**/__pycache__/

# tools
tools/prometheus-rule-tables/__pycache__/

# Direct NetBox bootstrap development environment
/.venv/
/.ansible/

# Historical copies retain private/runtime exclusions.
archive/deployments/air-gapped-mirror/sync-job/.venv/
archive/deployments/air-gapped-mirror/sync-job/**/__pycache__/
archive/deployments/air-gapped-mirror/sync-job/.pytest_cache/
archive/deployments/air-gapped-mirror/test/keys/
archive/deployments/monitoring/k8s/grafana-admin-secret.yaml
archive/automation/ansible/.venv/
archive/tools/netbox/csv-import/.venv/
archive/tools/netbox/csv-import/**/__pycache__/
archive/tools/netbox/csv-import/.pytest_cache/
archive/tools/netbox/inventory-collector/output/
archive/tools/netbox/inventory-collector/**/__pycache__/
archive/tools/prometheus-rule-tables/__pycache__/
